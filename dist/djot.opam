# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A djot parser extracted from a Rocq development"
description: """
OCaml sources extracted from the Gallina parser in djot.v, whose
roundtrip and well-formedness properties are proved in Rocq.  The
extraction output is committed here so that building the parser needs
no Rocq installation.  `Djot.Html.convert : string -> string` takes
djot source to HTML."""
maintainer: ["hongyu <linerwang1997@gmail.com>"]
authors: ["hongyu"]
homepage: "https://github.com/hon-gyu/djot.v"
bug-reports: "https://github.com/hon-gyu/djot.v/issues"
depends: [
  "dune" {>= "3.20"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hon-gyu/djot.v.git"
x-maintenance-intent: ["(latest)"]
