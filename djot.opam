opam-version: "2.0"
version: "0.1.0"
synopsis: "A djot parser extracted from a Rocq development"
description: """
A djot parser and HTML renderer extracted to OCaml from djot.v, a djot
parser verified in Rocq. Optional parts: djot.json (needs jsont and
bytesrw), YAML frontmatter (yaml), and the djot CLI (cmdliner)."""
maintainer: ["hongyu <linerwang1997@gmail.com>"]
authors: ["hongyu"]
license: "MIT AND ISC"
homepage: "https://github.com/hon-gyu/djot.v"
bug-reports: "https://github.com/hon-gyu/djot.v/issues"
depends: [
  "dune" {>= "3.20"}
  "odoc" {with-doc}
]
depopts: ["jsont" "bytesrw" "yaml" "cmdliner"]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hon-gyu/djot.v.git"
x-maintenance-intent: ["(latest)"]
