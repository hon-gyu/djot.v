+Lemma oresolve_map_rev :
+  forall ns,
+    no_adjacent_str (List.rev ns) = true ->
+    oresolve (List.rev (List.map OIn ns)) = List.rev ns.
+Proof.
+  intros ns H. rewrite <- List.map_rev. apply oresolve_map, H.
+Qed.
