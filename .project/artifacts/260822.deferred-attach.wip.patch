+(* No seam to merge, so the snoc is a cons. *)
+Lemma isnoc_cons :
+  forall n m out,
+    (plain_str n && plain_str m)%bool = false ->
+    isnoc n (m :: out)%list = (n :: m :: out)%list.
+Proof.
+  intros [p a v] [q b w] out H. unfold isnoc, plain_str in H |- *.
+  destruct b as [|kv b']; [|reflexivity].
+  destruct w; try reflexivity.
+  destruct a as [|ka a']; [|reflexivity].
+  destruct v; try reflexivity.
+  cbn in H. discriminate.
+Qed.
