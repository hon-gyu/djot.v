+(* Nothing waiting and no seam to merge: resolution gives the list back.
+   This is what every equational lemma about closing a scope needs, since
+   those scopes are built by `oemit_all` out of nodes already settled. *)
+Lemma oresolve_map :
+  forall ns, no_adjacent_str ns = true -> oresolve (List.map OIn ns) = ns.
+Proof.
+  induction ns as [|n ns IH]; intros H; [reflexivity|].
+  cbn [List.map oresolve].
+  destruct ns as [|m ns']; [reflexivity|].
+  cbn [no_adjacent_str] in H. apply andb_true_iff in H as [Hp H].
+  rewrite (IH H). apply negb_true_iff in Hp. apply isnoc_cons, Hp.
+Qed.
